# Данные не храним в git (лицензия OULAD CC-BY 4.0, но файлы большие ~450 МБ)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep
# результаты для статьи хранятся в репозитории (кроме большой панели индекса)
!outputs/hmm4/
outputs/hmm4/engagement_index.*

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# ОС / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
